<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped to this repository so `dotnet restore`/`dotnet add package` don't depend on a
    corporate feed (nexus.ecri.org) this machine's global NuGet config also lists but that isn't
    reachable from every environment this repo is built in. Does not modify user-wide settings.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
